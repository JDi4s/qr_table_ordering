#!/usr/bin/env bash
set -euo pipefail

EVENTS="${EVENTS:-10}"
INTERVAL_SECONDS="${INTERVAL_SECONDS:-30}"
FINAL_WAIT_SECONDS="${FINAL_WAIT_SECONDS:-180}"
STAMP="$(date -u +%Y%m%d-%H%M%S)"
LOG_DIR="tmp/service-tests"
SERVER_LOG="$LOG_DIR/ensaio-$STAMP-servidor.log"
SUMMARY_LOG="$LOG_DIR/ensaio-$STAMP-resumo.log"

mkdir -p "$LOG_DIR"

docker compose logs --no-color --since 1m -f web > "$SERVER_LOG" 2>&1 &
LOG_PID=$!

stop_log_capture() {
  kill "$LOG_PID" 2>/dev/null || true
  wait "$LOG_PID" 2>/dev/null || true
  echo ""
  echo "Resumo: $SUMMARY_LOG"
  echo "Logs do servidor: $SERVER_LOG"
}
trap stop_log_capture EXIT INT TERM

echo "A capturar os erros do servidor em $SERVER_LOG"
echo "O ensaio demora cerca de $(( (EVENTS - 1) * INTERVAL_SECONDS + FINAL_WAIT_SECONDS )) segundos."

docker compose exec -T \
  -e EVENTS="$EVENTS" \
  -e INTERVAL_SECONDS="$INTERVAL_SECONDS" \
  -e FINAL_WAIT_SECONDS="$FINAL_WAIT_SECONDS" \
  web bin/rails simulation:live_service 2>&1 | tee "$SUMMARY_LOG"
