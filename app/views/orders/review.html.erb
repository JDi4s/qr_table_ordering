<p class="eyebrow">MESA <%= @table.number %></p><h1>Confirme o seu pedido</h1>
<section class="panel">
  <% @review_items.each do |item| %><div class="line"><span><%= item[:quantity] %> × <%= item[:name] %></span><strong><%= euros(item[:line_total]) %></strong></div><% end %>
  <div class="line"><strong>Total</strong><strong><%= euros(@review_total) %></strong></div>
  <% if @review_note.present? %><p>Observações: <%= @review_note %></p><% end %>
  <p>O estabelecimento irá confirmar a disponibilidade. O pagamento é feito no estabelecimento.</p>
  <%= form_with url: table_orders_path(@table) do %>
    <%= hidden_field_tag :quote, @quote %><button type="submit">Enviar pedido</button>
  <% end %>
</section>
<p><%= link_to 'Voltar ao menu', new_table_order_path(@table) %></p>
