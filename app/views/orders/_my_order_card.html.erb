<section class="panel" id="<%= dom_id(order) %>">
  <div class="line"><h2>Pedido #<%= order.id %></h2><span class="badge"><%= state_label(order.status) %></span></div>
  <% if order.note.present? %><p>As suas observações: <%= order.note %></p><% end %>
  <% order.order_items.each do |item| %>
    <div class="line"><div><strong><%= item.quantity %> × <%= item.display_name %></strong>
      <% if item.denied? %><p class="danger">Indisponível: <%= item.denial_reason %></p><% end %>
      <% unless item.denied? %><p><%= item.paid_quantity %> pago(s) · <%= item.remaining_quantity %> por pagar</p><% end %>
      <% if item.proposed_description.present? %><p>Alteração proposta: <strong><%= item.proposed_description %></strong></p><% end %>
    </div><span><%= item.denied? ? 'Excluído' : euros(item.unit_price * item.quantity) %></span></div>
  <% end %>
  <div class="line"><strong><%= order.pending? ? 'Total provisório' : 'Total' %></strong><strong><%= euros(order.total) %></strong></div>
  <% if order.paid? %><p class="badge">Pago no balcão</p><% elsif order.paid_total.positive? %><p class="badge">Pagamento parcial no balcão</p><% end %>
  <% if order.pending? %><p>O funcionário está a avaliar a disponibilidade. Aguarde a confirmação.</p><% end %>
  <% if order.needs_customer_action? %>
    <div class="flash notice"><strong>O seu pedido tem alterações.</strong> Confirme os produtos, as alterações e o novo total antes de continuar.</div>
    <%= button_to 'Aceitar este pedido atualizado', accept_remaining_table_order_path(order.table, order) %>
  <% end %>
  <% if order.pending? && order.created_at < 3.minutes.ago %><p class="danger">O prazo de 3 minutos para cancelar terminou.</p><% end %>
  <% if order.cancellable_by_customer? %>
    <%= button_to 'Cancelar pedido', cancel_table_order_path(order.table, order), class: 'secondary', data: { confirmation_message: 'Cancelar todo o pedido?' } %>
  <% end %>
  <% if order.denied? %><p><%= order.cancellation_reason.presence || order.denial_reason %></p><% end %>
</section>
