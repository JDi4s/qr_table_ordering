<% active = local_assigns.fetch(:active, true) %>
<% include_children = local_assigns.fetch(:include_children, true) %>
<% cart_quantities = local_assigns.fetch(:cart_quantities, {}) %>
<% if category.visible_to_customers? %>
  <section id="menu-category-<%= category.id %>" class="customer-menu-section menu-category level-<%= level %>" data-customer-menu-target="categoryPanel" <%= 'hidden' unless active %>>
    <%= content_tag(level.zero? ? :h2 : :h3, category.name, class: "menu-category-title level-#{level}") %>

  <% items = category.menu_items.select(&:available?).sort_by(&:name) %>

    <% unless items.empty? %>
      <div class="customer-menu-grid">
        <% items.each do |item| %>
          <% quantity = cart_quantities[item.id.to_s].to_i %>
          <article class="panel customer-product-card <%= 'is-added' if quantity.positive? %>" data-customer-menu-target="product" data-price="<%= item.price %>" data-price-cents="<%= (item.price * 100).round %>" data-search-text="<%= h([item.name, item.description].compact.join(' ').downcase) %>" role="button" tabindex="0" data-action="click->customer-menu#toggleProduct keydown->customer-menu#toggleProduct" aria-label="<%= quantity.positive? ? "Aumentar quantidade de #{item.name}" : "Adicionar #{item.name}" %>">
            <div class="customer-product-media">
              <button type="button" class="customer-product-info-button" data-action="click->product-info#open:stop" aria-label="Informação sobre <%= item.name %>" aria-haspopup="dialog"><span aria-hidden="true">i</span></button>
              <% if item.image.attached? %>
                <%= image_tag item.image, alt: item.name, class: 'product-image', loading: 'lazy' %>
              <% else %>
                <div class="product-image-placeholder" aria-hidden="true">Sem imagem</div>
              <% end %>
            </div>

            <div class="customer-product-content">
              <strong><%= item.name %></strong>
              <% if item.description.present? %><p class="product-description"><%= item.description %></p><% end %>
              <p class="customer-product-price"><%= euros(item.price) %></p>
              <%= number_field_tag "order[items][#{item.id}]", quantity, min: 0, max: 99, step: 1, id: "quantity_#{item.id}", class: 'customer-quantity-input', aria: { label: "Quantidade de #{item.name}" } %>
              <div class="customer-product-action-slot">
                <button type="button" class="customer-remove-button customer-quantity-button" <%= 'disabled' unless quantity.positive? %> data-action="click->customer-menu#decrease:stop" aria-label="Remover uma unidade de <%= item.name %>"><span class="sr-only">−</span></button>
                <strong class="quantity-value" aria-live="polite" aria-label="Quantidade de <%= item.name %>"><%= quantity %></strong>
                <button type="button" class="customer-add-button customer-quantity-button" <%= 'disabled' if quantity >= 99 %> data-action="click->customer-menu#increase:stop" aria-label="Adicionar uma unidade de <%= item.name %>"><span class="sr-only">+</span></button>
              </div>
            </div>
            <%= render 'orders/product_information', item: item %>
          </article>
        <% end %>
      </div>
    <% end %>

    <% if include_children %>
      <% category.children.order(:name).each do |child| %>
        <%= render 'orders/category_menu', category: child, level: level + 1, cart_quantities: cart_quantities %>
      <% end %>
    <% end %>
  </section>
<% end %>
