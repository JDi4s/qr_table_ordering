<aside class="google-review-invitation" data-controller="google-review" data-google-review-establishment-value="<%= establishment.id %>" aria-label="Avaliações Google">
  <button type="button" class="google-review-dismiss" data-action="google-review#dismiss" aria-label="Fechar convite de avaliação">×</button>
  <h3>Já conheces o nosso espaço?</h3>
  <p>Partilha a tua experiência no Google.</p>
  <%= link_to establishment.google_review_url, class: 'button secondary google-review-link', target: '_blank', rel: 'noopener noreferrer' do %>
    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285f4" d="M21.6 12.2c0-.7-.1-1.5-.2-2.2H12v4.2h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.8 3-4.3 3-7.5Z"/><path fill="#34a853" d="M12 22c2.7 0 5-.9 6.6-2.3l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Z"/><path fill="#fbbc05" d="M6.4 14.1a6 6 0 0 1 0-4.2V7.3H3.1a10 10 0 0 0 0 9.4l3.3-2.6Z"/><path fill="#ea4335" d="M12 5.8c1.5 0 2.8.5 3.8 1.5L18.6 4A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.9 5.3l3.3 2.6C7.2 7.6 9.4 5.8 12 5.8Z"/></svg>
    Avaliar no Google <span aria-hidden="true">↗</span>
  <% end %>
</aside>
