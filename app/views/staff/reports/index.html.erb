<% export_params = @report_tab == 'cash' ? { tab: 'cash', date: @date } : @filter_params %>
<div class="report-dashboard report-v2">
  <div class="report-heading"><div><p class="eyebrow">CONTROLO FINANCEIRO</p><h1>Relatórios e caixa</h1></div><details class="report-export-menu"><summary class="button secondary report-export">Extrair relatório</summary><div class="report-export-options"><%= link_to 'PDF', pdf_staff_reports_path(export_params), class: 'button' %><%= link_to 'CSV', export_staff_reports_path(export_params), class: 'button secondary' %></div></details></div>
  <nav class="report-tabs" aria-label="Área financeira"><%= link_to 'Estatísticas', staff_reports_path(tab: 'statistics'), class: (@report_tab == 'statistics' ? 'is-active' : '') %><%= link_to 'Caixa', staff_reports_path(tab: 'cash', date: (@date || Date.current)), class: (@report_tab == 'cash' ? 'is-active' : '') %></nav>

  <% if @report_tab == 'statistics' %>
    <section class="panel report-filter report-explorer">
      <p class="eyebrow">ANÁLISE</p><h2>O que queres analisar?</h2>
      <% analysis_values = { 'employees' => "#{@employees.size} pessoas", 'products' => "#{@statistics.products.size} artigos", 'revenue' => euros(@statistics.total), 'orders' => "#{@statistics.orders_count} pedidos" } %>
      <div class="report-choice-grid"><% [['employees','Funcionários'],['products','Produtos'],['revenue','Receita'],['orders','Pedidos']].each do |value, label| %><%= link_to staff_reports_path(@filter_params.to_h.merge(analysis: value, metric: nil)), class: (@analysis == value ? 'is-active' : '') do %><span><%= label %></span><small><%= analysis_values[value] %></small><% end %><% end %></div>
      <p class="report-field-label">Indicador</p>
      <% labels = { 'employees' => [['calls','Chamadas'],['tables','Mesas atendidas'],['sales','Vendas']], 'products' => [['top','Mais vendidos'],['bottom','Menos vendidos'],['revenue','Receita por produto']], 'revenue' => [['total','Total recebido'],['tables','Receita por mesa'],['employees','Receita por funcionário'],['average','Ticket médio']], 'orders' => [['total','Todos os pedidos'],['served','Servidos'],['cancelled','Cancelados']] } %>
      <% metric_values = { 'calls' => "#{@call_rows.sum { |row| row[:count] }} chamadas", 'tables' => "#{@table_staff_rows.sum { |row| row[:value] }} mesas", 'sales' => euros(@statistics.total), 'top' => "#{@statistics.products.values.sum { |row| row[:quantity] }} un.", 'bottom' => "#{@statistics.products.values.sum { |row| row[:quantity] }} un.", 'revenue' => euros(@statistics.total), 'total' => euros(@statistics.total), 'average' => euros(@statistics.average), 'served' => "#{@order_rows[:served]} pedidos", 'cancelled' => "#{@order_rows[:cancelled]} pedidos" } %>
      <div class="report-choice-list"><% labels.fetch(@analysis).each do |value, label| %><%= link_to staff_reports_path(@filter_params.to_h.merge(metric: value)), class: (@metric == value ? 'is-active' : '') do %><span><%= label %></span><small><%= metric_values[value] %></small><% end %><% end %></div>
      <p class="report-field-label">Período</p>
      <div class="report-period-switch"><% [['day','Dia'],['month','Mês'],['year','Ano'],['lifetime','Tempo total']].each do |value, label| %><% target_period = @filter_params.to_h.merge(view: value); target_period[:date] = Date.current.iso8601 if value == 'day'; target_period[:month] = Date.current.strftime('%Y-%m') if value == 'month'; target_period[:year] = Date.current.year if value == 'year' %><%= link_to label, staff_reports_path(target_period), class: (@period.view == value ? 'is-active' : '') %><% end %></div>
      <div class="report-period-nav"><% if @period.view != 'lifetime' %><% previous = @period.from - (@period.view == 'day' ? 1 : @period.view == 'month' ? 1.month : 1.year) %><% next_period = @period.from + (@period.view == 'day' ? 1 : @period.view == 'month' ? 1.month : 1.year) %><%= link_to '‹', staff_reports_path(@filter_params.to_h.merge(view: @period.view, date: previous.iso8601, month: previous.strftime('%Y-%m'), year: previous.year)), class: 'report-arrow', aria_label: 'Período anterior' %><% end %><button type="button" class="report-period-button" data-period-dialog-open><strong><%= @period.label %></strong><span>⌄</span></button><% if @period.view != 'lifetime' && @period.to < Date.current %><%= link_to '›', staff_reports_path(@filter_params.to_h.merge(view: @period.view, date: next_period.iso8601, month: next_period.strftime('%Y-%m'), year: next_period.year)), class: 'report-arrow', aria_label: 'Período seguinte' %><% end %></div>
      <% if @analysis == 'employees' %><%= form_with url: staff_reports_path, method: :get, class: 'report-employee-filter' do %><%= hidden_field_tag :tab, 'statistics' %><%= hidden_field_tag :analysis, @analysis %><%= hidden_field_tag :metric, @metric %><%= hidden_field_tag :view, @period.view %><%= hidden_field_tag :date, @period.from.iso8601 %><%= select_tag :employee_id, options_for_select([['Todos os funcionários','']] + @employees.map { |employee| [employee.name.presence || employee.login_identifier, employee.id] }, @employee&.id), onchange: 'this.form.submit()', aria: { label: 'Escolher funcionário' } %><% end %><% end %>
    </section>

    <div class="report-stat-grid report-stat-grid-compact"><% [['Total recebido', euros(@statistics.total)],['Pagamentos', @statistics.payments_count],['Pedidos', @statistics.orders_count],['Ticket médio', euros(@statistics.average)]].each do |label, value| %><div class="report-stat"><strong><%= value %></strong><span><%= label %></span></div><% end %></div>

    <section class="panel report-card report-chart-card report-focus-card">
      <div class="report-chart-heading"><div><p class="eyebrow">EVOLUÇÃO</p><h2><%= labels.fetch(@analysis).find { |pair| pair[0] == @metric }&.last || 'Resultados' %></h2><span class="report-period-label"><%= @period.label %></span></div><div class="report-chart-kpis"><span><small>Total</small><strong><%= euros(@statistics.total) %></strong></span><span><small>Máximo</small><strong><%= euros(@chart_rows.map { |r| r[:amount] }.max.to_d) %></strong></span></div></div>
      <% max_chart = [@chart_rows.map { |row| row[:amount].to_d }.max.to_d, 1.to_d].max %><% count_chart = @analysis == 'orders' || (@analysis == 'employees' && %w[calls tables].include?(@metric)) || (@analysis == 'products' && @metric != 'revenue') %><% chart_value = ->(value) { count_chart ? value.to_i.to_s : euros(value) } %>
      <% chart_categorical = %w[products employees orders].include?(@analysis) && !(@analysis == 'employees' && @metric == 'sales') %>
      <% if @chart_rows.any? %><div class="report-chart-stage"><div class="report-chart-scale"><span><%= chart_value.call(max_chart) %></span><span>0<%= count_chart ? '' : ' €' %></span></div><div class="report-chart-scroll"><div class="report-chart report-chart-<%= @period.view %> <%= 'report-chart-categorical' if chart_categorical %>" data-report-chart role="img" aria-label="Evolução no período"><% @chart_rows.each do |row| %><div class="report-chart-column" tabindex="0" data-chart-label="<%= row[:label] %>" data-chart-value="<%= chart_value.call(row[:amount]) %>" aria-label="<%= row[:label] %>: <%= chart_value.call(row[:amount]) %>"><div class="report-chart-bars"><span class="report-bar current" style="height:<%= (row[:amount].to_d / max_chart * 100).round(2) %>%"></span></div><small class="report-chart-label"><%= row[:label] %></small></div><% end %></div></div><div class="report-chart-tooltip" data-chart-tooltip hidden><strong data-tooltip-label></strong><span><i></i><b data-tooltip-value></b></span></div></div><div class="report-legend"><span><i class="current"></i>Período escolhido</span></div><% else %><div class="report-chart-empty">Sem dados para este período.</div><% end %>
    </section>

    <% if @analysis == 'employees' %><section class="panel report-card"><h2><%= @metric == 'calls' ? 'Chamadas por funcionário' : @metric == 'tables' ? 'Mesas atendidas' : 'Vendas por funcionário' %></h2><p class="report-note">Os valores correspondem ao indicador escolhido.</p><% rows = @metric == 'calls' ? @call_rows.map { |r| { name: r[:name], value: r[:count], label: 'chamadas' } } : @metric == 'tables' ? @table_staff_rows : @staff_rows.map { |r| { name: r[:name], value: r[:amount], label: 'pagamentos' } } %><%= render 'report_rows', rows: rows %></section>
    <% elsif @analysis == 'products' %><section class="panel report-card"><h2><%= @metric == 'bottom' ? 'Produtos menos vendidos' : @metric == 'revenue' ? 'Receita por produto' : 'Produtos mais vendidos' %></h2><%= render 'report_rows', rows: @product_rows.map { |r| { name: r[:name], value: @metric == 'revenue' ? r[:amount] : r[:quantity], label: @metric == 'revenue' ? '€' : 'un.' } } %></section>
    <% elsif @analysis == 'revenue' %><section class="panel report-card"><h2><%= @metric == 'tables' ? 'Receita por mesa' : @metric == 'employees' ? 'Receita por funcionário' : 'Por método de pagamento' %></h2><% rows = @metric == 'tables' ? @table_rows.map { |key, value| { name: "Mesa #{key}", value: value, label: '€' } } : @metric == 'employees' ? @employee_rows.map { |r| { name: r[:name], value: r[:amount], label: '€' } } : @methods.map { |key, value| { name: payment_method_label(key), value: value, label: '€' } } %><%= render 'report_rows', rows: rows %></section>
    <% else %><section class="panel report-card"><h2>Resumo de pedidos</h2><%= render 'report_rows', rows: [['total','Todos'],['served','Servidos'],['cancelled','Cancelados']].map { |key, label| { name: label, value: @order_rows[key.to_sym], label: 'pedidos' } } %></section><% end %>
  <% else %>
    <% previous_cash_date = @date - 1; next_cash_date = @date + 1 %>
    <section class="panel report-cash-period"><p class="eyebrow">ESCOLHER DIA</p><div class="report-cash-date-nav"><%= link_to '‹', staff_reports_path(tab: 'cash', date: previous_cash_date.iso8601), class: 'report-arrow', aria_label: 'Dia anterior' %><%= form_with url: staff_reports_path, method: :get, class: 'report-cash-date-form' do %><%= hidden_field_tag :tab, 'cash' %><%= date_field_tag :date, @date, onchange: 'this.form.submit()', aria: { label: 'Escolher dia' } %><% end %><% if next_cash_date <= Date.current %><%= link_to '›', staff_reports_path(tab: 'cash', date: next_cash_date.iso8601), class: 'report-arrow', aria_label: 'Dia seguinte' %><% else %><span class="report-arrow is-disabled">›</span><% end %></div></section>
    <div class="report-stat-grid report-cash-summary report-cash-stat-grid"><% [['Total recebido', euros(@statistics.total)],['Pagamentos', @statistics.payments_count],['Pedidos pagos', @statistics.orders_count],['Mesas por pagar', @unpaid_tables.size]].each do |label, value| %><div class="report-stat"><strong><%= value %></strong><span><%= label %></span></div><% end %></div>
    <section class="panel report-card report-cash-status"><div class="report-section-title"><div><p class="eyebrow">ESTADO DO CAIXA</p><h2><%= @closure ? 'Caixa fechado' : 'Caixa aberto' %></h2></div><span class="badge"><%= @closure ? 'Fechado' : 'Aberto' %></span></div><% if @closure %><p>Fechado por <strong><%= @closure.user.name.presence || @closure.user.login_identifier %></strong> às <%= @closure.closed_at.strftime('%H:%M') %>.</p><% else %><p>Confirma o total recebido deste dia quando terminares o serviço.</p><%= button_to 'Fechar caixa deste dia', close_staff_reports_path(date: @date), method: :post, class: 'report-cash-close-button' %><% end %></section>
    <section class="panel report-card"><p class="eyebrow">RECEBIMENTOS</p><h2>Por método</h2><%= render 'report_rows', rows: @statistics.by_method.sort_by { |_, amount| -amount }.map { |key, value| { name: payment_method_label(key), value: value, label: '€' } } %></section>
    <section class="panel report-card"><p class="eyebrow">AÇÕES PENDENTES</p><h2>Mesas por pagar</h2><% if @unpaid_tables.any? %><div class="report-cash-pending-list"><% @unpaid_tables.each do |table| %><div class="report-cash-pending-row"><div><strong>Mesa <%= table.number %></strong><small>Tem pedidos pendentes</small></div><%= link_to 'Abrir mesa', staff_table_path(table), class: 'button secondary' %></div><% end %></div><% else %><p class="report-muted">Nenhuma mesa pendente.</p><% end %></section>
  <% end %>
</div>

<% if @report_tab == 'statistics' %>
<dialog class="report-period-dialog" data-period-dialog>
  <div class="report-period-sheet">
    <div class="report-period-dialog-head"><div><p class="eyebrow">ESCOLHER PERÍODO</p><h2 data-period-dialog-title>Escolher data</h2></div><button type="button" class="report-dialog-close" data-period-dialog-close aria-label="Fechar">×</button></div>
    <div class="report-calendar-toolbar"><button type="button" data-calendar-prev aria-label="Anterior">‹</button><strong data-calendar-label></strong><button type="button" data-calendar-next aria-label="Seguinte">›</button></div>
    <div class="report-calendar-weekdays"><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span><span>Dom</span></div>
    <div class="report-calendar-grid" data-calendar-grid></div>
    <%= form_with url: staff_reports_path, method: :get, class: 'report-period-dialog-form', data: { period_form: true } do %>
      <%= hidden_field_tag :tab, 'statistics' %><%= hidden_field_tag :analysis, @analysis %><%= hidden_field_tag :metric, @metric %><%= hidden_field_tag :view, @period.view, data: { period_view: true } %><%= hidden_field_tag :date, @period.from.iso8601, data: { period_date: true } %><%= hidden_field_tag :month, @period.from.strftime('%Y-%m'), data: { period_month: true } %><%= hidden_field_tag :year, @period.from.year, data: { period_year: true } %><%= hidden_field_tag :employee_id, @employee&.id %>
      <button type="submit" class="button" data-period-confirm>Confirmar período</button><button type="button" class="button secondary" data-period-dialog-close>Cancelar</button>
    <% end %>
  </div>
</dialog>

<script>
  (() => {
    const dialog = document.querySelector('[data-period-dialog]');
    const open = document.querySelector('[data-period-dialog-open]');
    if (!dialog || !open) return;
    const grid = dialog.querySelector('[data-calendar-grid]');
    const label = dialog.querySelector('[data-calendar-label]');
    const view = dialog.querySelector('[data-period-view]');
    const date = dialog.querySelector('[data-period-date]');
    const month = dialog.querySelector('[data-period-month]');
    const year = dialog.querySelector('[data-period-year]');
    let selected = new Date(`${date.value}T00:00:00`);
    let cursor = new Date(selected.getFullYear(), selected.getMonth(), 1);
    const monthNames = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
    const pad = value => String(value).padStart(2, '0');
    const iso = value => `${value.getFullYear()}-${pad(value.getMonth() + 1)}-${pad(value.getDate())}`;
    const render = () => {
      grid.innerHTML = '';
      label.textContent = `${monthNames[cursor.getMonth()]} ${cursor.getFullYear()}`;
      const firstDay = (new Date(cursor.getFullYear(), cursor.getMonth(), 1).getDay() + 6) % 7;
      for (let i = 0; i < firstDay; i += 1) grid.appendChild(document.createElement('span'));
      const days = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0).getDate();
      for (let day = 1; day <= days; day += 1) {
        const button = document.createElement('button');
        button.type = 'button'; button.textContent = day;
        const value = new Date(cursor.getFullYear(), cursor.getMonth(), day);
        if (value.toDateString() === selected.toDateString()) button.classList.add('is-selected');
        button.addEventListener('click', () => { selected = value; date.value = iso(value); month.value = `${value.getFullYear()}-${pad(value.getMonth() + 1)}`; year.value = value.getFullYear(); render(); });
        grid.appendChild(button);
      }
    };
    open.addEventListener('click', () => { dialog.showModal(); render(); });
    dialog.querySelectorAll('[data-period-dialog-close]').forEach(button => button.addEventListener('click', () => dialog.close()));
    dialog.querySelector('[data-calendar-prev]').addEventListener('click', () => { cursor.setMonth(cursor.getMonth() - 1); render(); });
    dialog.querySelector('[data-calendar-next]').addEventListener('click', () => { cursor.setMonth(cursor.getMonth() + 1); render(); });
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });

    document.querySelectorAll('[data-report-chart]').forEach(chart => {
      const tooltip = chart.closest('.report-chart-stage').querySelector('[data-chart-tooltip]');
      const tooltipLabel = tooltip.querySelector('[data-tooltip-label]');
      const tooltipValue = tooltip.querySelector('[data-tooltip-value]');
      const hideTooltip = () => { tooltip.hidden = true; chart.querySelectorAll('.is-chart-selected').forEach(item => item.classList.remove('is-chart-selected')); };
      const showTooltip = column => {
        chart.querySelectorAll('.is-chart-selected').forEach(item => item.classList.remove('is-chart-selected'));
        column.classList.add('is-chart-selected');
        tooltipLabel.textContent = column.dataset.chartLabel;
        tooltipValue.textContent = column.dataset.chartValue;
        tooltip.hidden = false;
        const chartBox = chart.getBoundingClientRect();
        const columnBox = column.getBoundingClientRect();
        const tooltipWidth = Math.min(190, chartBox.width - 16);
        tooltip.style.width = `${tooltipWidth}px`;
        let left = columnBox.left - chartBox.left + (columnBox.width / 2) - (tooltipWidth / 2);
        left = Math.max(8, Math.min(left, chartBox.width - tooltipWidth - 8));
        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${Math.max(8, columnBox.top - chartBox.top - 74)}px`;
      };
      chart.querySelectorAll('.report-chart-column').forEach(column => {
        column.addEventListener('click', event => { event.stopPropagation(); showTooltip(column); });
        column.addEventListener('mouseenter', () => showTooltip(column));
        column.addEventListener('focus', () => showTooltip(column));
      });
      chart.addEventListener('click', event => { if (!event.target.closest('.report-chart-column')) hideTooltip(); });
      document.addEventListener('click', event => { if (!event.target.closest('[data-report-chart]')) hideTooltip(); }, { passive: true });
    });
  })();
</script>
<% end %>
