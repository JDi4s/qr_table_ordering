<header class="staff-header">
  <div class="staff-identity">
    <span class="brand">Mesa<span> • </span></span><strong><%= current_establishment.name %></strong>
  </div>
  <nav class="staff-main-nav" aria-label="Navegação principal">
    <div class="staff-nav-group">
      <%= link_to 'Pedidos', staff_orders_path, class: ('is-active' if staff_nav_active?(:orders)), aria: { current: (staff_nav_active?(:orders) ? 'page' : nil) } %>
      <%= link_to 'Mesas', active_staff_tables_path, class: ('is-active' if staff_nav_active?(:tables)), aria: { current: (staff_nav_active?(:tables) ? 'page' : nil) } %>
      <%= link_to 'Menu', staff_menu_path, class: ('is-active' if staff_nav_active?(:menu)), aria: { current: (staff_nav_active?(:menu) ? 'page' : nil) } %>
    </div>
    <div class="staff-nav-group staff-nav-secondary">
      <%= link_to 'Mesas / QR', staff_tables_path, class: ('is-active' if current_page?(staff_tables_path)), aria: { current: (current_page?(staff_tables_path) ? 'page' : nil) } %>
      <%= link_to 'Histórico', history_staff_orders_path, class: ('is-active' if staff_nav_active?(:history)), aria: { current: (staff_nav_active?(:history) ? 'page' : nil) } %>
      <% if manager_access? %><%= link_to 'Relatórios', staff_reports_path, class: ('is-active' if staff_nav_active?(:reports)), aria: { current: (staff_nav_active?(:reports) ? 'page' : nil) } %><% end %>
      <%= link_to 'Definições', edit_staff_settings_path, class: ('is-active' if controller_path.start_with?('staff/settings') || controller_path.start_with?('staff/users') || controller_path.start_with?('staff/support_ticket')), aria: { current: ((controller_path.start_with?('staff/settings') || controller_path.start_with?('staff/users') || controller_path.start_with?('staff/support_ticket')) ? 'page' : nil) } %>
    </div>
  </nav>
  <% if support_mode? %><%= button_to 'Terminar suporte', admin_support_session_path(active_support_session), method: :delete, class: 'secondary staff-logout' %><% else %><%= button_to 'Sair', logout_path, method: :delete, class: 'secondary staff-logout' %><% end %>
</header>
<% if support_mode? %><div class="support-mode-banner"><span><strong>Modo Suporte</strong> · <%= current_establishment.name %></span><small>Configuração autorizada · operação apenas para consulta · termina em <%= active_support_session.expires_at.strftime('%H:%M') %></small></div><% end %>
