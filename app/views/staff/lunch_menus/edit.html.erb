<div class="lunch-management" data-controller="scheduled-menu-editor">
  <%= link_to '← Menu', staff_menu_path %><h1><%= @kind == 'lunch' ? 'Menu de almoço' : 'Pequeno-almoço' %></h1>
  <p class="scheduled-menu-intro">Escolhe o horário, o que inclui e os produtos que o cliente pode pedir.</p>
  <% if @products.any? { |p| p.product_kind == 'unclassified' } %><div class="flash alert"><p>Existem produtos por classificar. <%= link_to 'Classificar produtos em lote', edit_staff_product_classification_path %> para filtrar as escolhas corretamente.</p></div><% end %>
  <%= form_with model: @lunch_menu, url: staff_lunch_menu_path(menu_kind: @kind), method: :patch, data: { turbo: false } do |f| %>
    <% if @lunch_menu.errors.any? %><div class="flash alert" role="alert"><%= @lunch_menu.errors.full_messages.join('. ') %></div><% end %>
    <section class="panel lunch-settings scheduled-publication">
      <div class="scheduled-section-heading"><div><h2>Publicação e horário</h2><p>Aparece ao cliente apenas nos dias e horas definidos.</p></div><label class="lunch-toggle"><%= f.check_box :active %> Ativar <%= @kind == 'lunch' ? 'menu de almoço' : 'pequeno-almoço' %></label></div>
      <div class="lunch-days"><%= hidden_field_tag 'lunch_menu[weekdays][]', '' %><% LunchMenu::DAYS.each do |label, value| %><label><%= check_box_tag 'lunch_menu[weekdays][]', value, @lunch_menu.weekdays.include?(value), id: "lunch_day_#{value}" %><%= label %></label><% end %></div>
      <div class="lunch-times"><label>Começa às <%= f.time_field :starts_at, required: true %></label><label>Termina às <%= f.time_field :ends_at, required: true %></label></div>
      <small>Horário de Lisboa. Fora deste horário, o menu deixa de aparecer automaticamente.</small>
    </section>
    <section class="panel lunch-settings"><div class="scheduled-section-heading"><div><h2>Produtos à unidade</h2><p>O cliente pede cada produto separadamente.</p></div><label class="lunch-toggle"><%= f.check_box :individual_enabled, data: { action: 'change->scheduled-menu-editor#sync', section_toggle: 'individual' } %> Vender à unidade</label></div>
      <div data-sale-section="individual"><p>Escolhe os produtos e o preço neste horário. O preço da carta mantém-se.</p><%= render 'options', field: 'individual_items', selected: @lunch_menu.individual_offers, money_key: 'price', money_label: 'Preço neste menu', default_price: true %></div>
    </section>
    <section class="panel lunch-settings"><div class="scheduled-section-heading"><div><h2>Menu completo</h2><p>Um preço para o conjunto escolhido.</p></div><label class="lunch-toggle"><%= f.check_box :combo_enabled, data: { action: 'change->scheduled-menu-editor#sync', section_toggle: 'combo' } %> Vender menu completo</label></div>
      <div data-sale-section="combo">
        <label class="scheduled-base-price">Preço do menu completo (€)<%= f.number_field :combo_price, min: 0, max: '99999.99', step: '0.01', required: true %></label>
        <h3>O que inclui?</h3><p>Assinala os grupos que fazem parte do menu. O cliente escolhe um produto de cada grupo incluído.</p>
        <div class="scheduled-group-choices"><% @editor_groups.each_with_index do |group,index| %><% selected = @lunch_menu.groups.any? { |g| g['key'] == group['key'] && (!g['optional'] || Array(@lunch_menu.combo_groups[g['key']]).any?) } %>
          <label class="scheduled-group-choice"><%= hidden_field_tag "groups[#{index}][enabled]", '0' %><%= check_box_tag "groups[#{index}][enabled]", '1', selected, id: "include_#{group['key']}", data: { group_key: group['key'], action: 'change->scheduled-menu-editor#sync' } %><%= group['name'] %></label>
        <% end %></div>
        <% @editor_groups.each_with_index do |group,index| %><% key,name = group.values_at('key','name') %>
          <div class="scheduled-group-products" data-group-panel="<%= key %>">
            <%= hidden_field_tag "groups[#{index}][key]", key %><%= hidden_field_tag "groups[#{index}][name]", name %><%= hidden_field_tag "groups[#{index}][types]", group['types'].join(',') %>
            <div class="scheduled-section-heading"><div><h3><%= name %></h3><small>Escolhe os produtos disponíveis para este grupo.</small></div><span class="scheduled-selection-count" data-selection-count aria-live="polite"></span></div>
            <%= render 'options', field: "combo_options[#{key}]", selected: Array(@lunch_menu.combo_groups[key]), money_key: 'supplement', money_label: 'Suplemento (€)', default_price: false, product_group: group %>
          </div>
        <% end %>
      </div>
    </section>
    <div class="scheduled-save-actions"><%= f.submit(@kind == 'lunch' ? 'Guardar menu de almoço' : 'Guardar pequeno-almoço') %></div>
  <% end %>
</div>
