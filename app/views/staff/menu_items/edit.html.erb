<h1>Produto</h1><section class="panel"><%= render 'shared/errors', record: @menu_item %>
<%= form_with model: [:staff, @menu_item] do |f| %>
  <%= f.label :name, 'Nome' %><%= f.text_field :name, required: true %>
  <%= f.label :category_id, 'Categoria' %><%= f.collection_select :category_id, current_establishment.categories.order(:name), :id, :name, {}, required: true %>
  <%= f.label :price, 'Preço (€)' %><%= f.number_field :price, min: 0, step: '0.01', required: true %>
  <label><%= f.check_box :available %> Disponível</label><%= f.submit 'Guardar' %>
<% end %></section><p><%= link_to 'Voltar', staff_menu_path %></p>
