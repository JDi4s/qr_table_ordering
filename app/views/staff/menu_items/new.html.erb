<h1>Produto</h1>

<section class="panel">
  <%= render 'shared/errors', record: @menu_item %>

  <%= form_with model: [:staff, @menu_item], html: { multipart: true } do |f| %>
    <%= f.label :name, 'Nome' %>
    <%= f.text_field :name, required: true %>

    <%= f.label :category_id, 'Categoria' %>
    <%= f.select :category_id,
      options_for_select(category_options(current_establishment.categories.to_a), @menu_item.category_id),
      {},
      required: true %>

    <%= f.label :price, 'Preço (€)' %>
    <%= f.number_field :price, min: 0, step: '0.01', required: true %>

    <%= f.label :image, 'Imagem do produto (opcional)' %>
    <%= f.file_field :image, accept: 'image/png,image/jpeg,image/webp' %>

    <label>
      <%= f.check_box :available %>
      Disponível
    </label>

    <%= f.submit 'Guardar' %>
  <% end %>
</section>

<p><%= link_to 'Voltar', staff_menu_path %></p>
