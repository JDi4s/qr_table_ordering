<p class="eyebrow">GESTÃO DO MENU</p><h1>Menu</h1>

<% if current_user.manager? %>
  <div class="toolbar menu-actions">
    <%= link_to 'Criar categoria', new_staff_category_path, class: 'button' %>
    <%= link_to 'Criar produto', new_staff_menu_item_path, class: 'button secondary' %>
  </div>
<% end %>

<div class="panel menu-help" data-controller="dismissible" data-dismissible-key-value="staff-menu-organization-help" data-dismissible-duration-value="86400000">
  <div>
    <strong>Organização rápida</strong>
    <span>As categorias estão agrupadas. Abre apenas a secção que queres editar.</span>
  </div>
  <%= button_tag '×', type: 'button', class: 'menu-help-close', data: { action: 'dismissible#close' }, aria: { label: 'Fechar ajuda' } %>
</div>

<% roots = @categories.select(&:root?).sort_by(&:name) %>
<% available_count = @categories.count { |category| !category.archived? && category.available? } %>
<% unavailable_count = @categories.count { |category| !category.archived? && !category.available? } %>
<% archived_count = @categories.count(&:archived?) %>
<%= turbo_frame_tag 'staff_menu_records' do %>
  <% if request.headers['Turbo-Frame'].present? %>
    <% flash.each do |kind, message| %><div class="flash <%= kind %>" role="status"><%= message %></div><% end %>
  <% end %>

  <div class="staff-menu-status" data-controller="staff-menu">
    <div class="staff-menu-status-tabs" role="tablist" aria-label="Estado do menu">
      <% [['active', 'Ativas', available_count], ['unavailable', 'Indisponíveis', unavailable_count], ['archived', 'Arquivadas', archived_count]].each do |value, label, count| %>
        <button type="button" class="staff-menu-status-tab <%= 'is-active' if @menu_status == value %>" data-staff-menu-target="tab" data-menu-status="<%= value %>" data-action="staff-menu#select" aria-selected="<%= @menu_status == value %>"><%= label %> <span><%= count %></span></button>
      <% end %>
    </div>
    <section data-staff-menu-target="panel" data-menu-status="active" <%= 'hidden' unless @menu_status == 'active' %>>
      <% roots.each do |category| %><%= render 'staff/menu/category', category: category, level: 0, status: 'active' %><% end %>
    </section>
    <section data-staff-menu-target="panel" data-menu-status="unavailable" <%= 'hidden' unless @menu_status == 'unavailable' %>>
      <% roots.each do |category| %><%= render 'staff/menu/category', category: category, level: 0, status: 'unavailable' %><% end %>
    </section>
    <section data-staff-menu-target="panel" data-menu-status="archived" <%= 'hidden' unless @menu_status == 'archived' %>>
      <% roots.each do |category| %><%= render 'staff/menu/category', category: category, level: 0, status: 'archived' %><% end %>
    </section>
  </div>
<% end %>
