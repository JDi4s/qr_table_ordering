<div class="staff-menu-page" data-controller="staff-menu" data-staff-menu-key-value="<%= current_establishment.id %>" data-action="click->staff-menu#remember submit->staff-menu#remember turbo:frame-load->staff-menu#restore">
<h1>Menu</h1>
<p class="staff-menu-intro">Organiza as categorias e os produtos do teu espaço.</p>

<% if manager_access? %>
<nav class="menu-main-tabs" aria-label="Gestão do menu"><%= link_to 'Carta', staff_menu_path, class: ('is-active' unless params[:menu_section] == 'scheduled') %><%= link_to 'Diárias / Brunch', staff_menu_path(menu_section: 'scheduled'), class: ('is-active' if params[:menu_section] == 'scheduled') %></nav>
<% if params[:menu_section] == 'scheduled' %><section data-menu-section-panel="scheduled">
<% if manager_access? %>
  <section class="scheduled-menu-overview" aria-label="Menus por horário">
    <div class="section-heading"><h2>Menus por horário</h2><p>Produtos e preços próprios, nos horários que escolheres.</p></div>
    <div class="scheduled-menu-cards"><% [['breakfast','Pequeno-almoço'],['lunch','Menu de almoço']].each do |kind,label| %>
      <% scheduled_menu = current_establishment.scheduled_menus.find_by(menu_kind: kind) %>
      <article class="panel scheduled-menu-card"><div><h3><%= scheduled_menu&.title.presence || label %></h3><p><%= scheduled_menu ? "#{scheduled_menu.starts_at.strftime('%H:%M')}–#{scheduled_menu.ends_at.strftime('%H:%M')}" : 'Ainda não configurado' %></p><span class="menu-schedule-state"><%= scheduled_menu&.active? ? 'Programado' : 'Desativado' %></span></div><%= link_to 'Configurar', edit_staff_lunch_menu_path(menu_kind: kind), class: 'button secondary', aria: { label: "Configurar #{label.downcase}" } %></article>
    <% end %></div>
  </section>
<% end %>
</section><% end %>
<% end %>
<section data-menu-section-panel="products">
<% if manager_access? %>
  <div class="toolbar menu-actions">
    <%= link_to 'Criar produto', new_staff_menu_item_path(menu_context_params), class: 'button' %>
    <% pending_products = current_establishment.menu_items.not_archived %>
    <% missing_products = pending_products.needing_classification(current_establishment) %>
    <% pending_classification = missing_products.count %>
    <% if pending_classification.positive? %><%= link_to "Classificar produtos (#{pending_classification})", edit_staff_product_classification_path, class: 'button secondary' %><% end %>
    <%= link_to 'Criar categoria', new_staff_category_path(menu_context_params), class: 'button secondary' %>
  </div>
<% end %>

<h2><%= params[:menu_section] == 'scheduled' ? 'Produtos de Diárias / Brunch' : 'Produtos da carta' %></h2>
<%= turbo_frame_tag 'staff_menu_records' do %>
  <% if request.headers['Turbo-Frame'].present? %>
    <% flash.each do |kind, message| %><div class="flash <%= kind %>" role="status"><%= message %></div><% end %>
  <% end %>

  <div class="staff-menu-status">
    <nav class="staff-menu-status-tabs" aria-label="Estado do menu">
      <% menu_tabs = [['active', 'Ativas'], ['unavailable', 'Indisponíveis'], ['archived', 'Arquivadas']] %>
      <% menu_tabs << ['uncategorized', 'Sem categoria'] if @menu_counts['uncategorized'].positive? %>
      <% menu_tabs.each do |value, label| %>
        <%= link_to staff_menu_path(menu_status: value, menu_view: params[:menu_view], menu_section: params[:menu_section]),
          class: "staff-menu-status-tab #{'is-active' if @menu_status == value}",
          aria: { current: ('page' if @menu_status == value) },
          data: { turbo_frame: 'staff_menu_records', turbo_action: 'advance' } do %>
          <%= label %> <span><%= @menu_counts[value] %></span>
        <% end %>
      <% end %>
    </nav>

    <section class="staff-menu-status-panel" data-menu-status="<%= @menu_status %>">
      <% if @menu_status == 'uncategorized' %>
        <div class="panel menu-records-heading">
          <div>
            <h2>Produtos sem categoria</h2>
            <p>Produtos que ficaram sem categoria depois de uma eliminação.</p>
          </div>
          <% if manager_access? && @uncategorized_category&.menu_items&.any? %>
            <%= button_to purge_uncategorized_staff_menu_items_path(menu_status: 'uncategorized', menu_section: params[:menu_section]),
              method: :delete, class: 'bulk-delete-button' do %>
              <span aria-hidden="true">🗑︎</span> Apagar todos
            <% end %>
          <% end %>
        </div>

        <% if @uncategorized_category&.menu_items&.any? %>
          <div class="panel uncategorized-products">
            <% @uncategorized_category.menu_items.select { |item| menu_product_matches?(item) }.sort_by(&:name).each do |item| %>
              <%= render 'staff/menu/item', item: item, status: 'uncategorized' %>
            <% end %>
          </div>
        <% else %>
          <div class="panel menu-empty-state">Não existem produtos sem categoria.</div>
        <% end %>
      <% else %>
        <% if @menu_status == 'archived' && manager_access? && @menu_counts['archived'].positive? %>
          <div class="panel menu-records-heading">
            <div>
              <h2>Registos arquivados</h2>
              <p>Elimina definitivamente todos os produtos e categorias desta área.</p>
            </div>
            <%= button_to purge_archived_staff_menu_items_path(menu_status: 'archived', menu_section: params[:menu_section]),
              method: :delete, class: 'bulk-delete-button' do %>
              <span aria-hidden="true">🗑︎</span> Apagar todos
            <% end %>
          </div>
        <% end %>

        <div class="staff-menu-list-heading"><strong>Categorias <%= @menu_status == 'active' ? 'ativas' : (@menu_status == 'unavailable' ? 'indisponíveis' : 'arquivadas') %></strong><span>Toque para ver os produtos</span></div>
        <% rendered_category = false %>
        <% @menu_roots.each do |category| %>
          <% content = render('staff/menu/category', category: category, level: 0, status: @menu_status, initially_open: !rendered_category) %>
          <% if content.present? %>
            <% rendered_category = true %>
            <%= content %>
          <% end %>
        <% end %>
        <% unless rendered_category %>
          <div class="panel menu-empty-state">Não existem registos neste separador.</div>
        <% end %>
      <% end %>
    </section>
  </div>
<% end %>
</section>
</div>
