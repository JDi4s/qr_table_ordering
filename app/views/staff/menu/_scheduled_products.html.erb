<div class="menu-group-heading"><h3>Grupos do menu</h3><% if manager_access? %><%= link_to '+ Criar grupo', edit_staff_lunch_menu_path(menu_kind: selected_menu_kind), class: 'menu-group-create' %><% end %></div>
<% products = @scheduled_products.select do |item|
  case @menu_status
  when 'active' then item.available? && !item.archived? && item.category.visible_to_customers?
  when 'unavailable' then !item.archived? && (!item.available? || !item.category.visible_to_customers?)
  when 'archived' then item.archived?
  else true
  end
end %>
<% assigned = products.select { |item| @scheduled_ids.include?(item.id) } %>
<% rendered_ids = [] %>
<div class="menu-group-grid">
<% @scheduled_groups.each_with_index do |group,index| %>
  <% explicit_ids = Array(@selected_menu.combo_groups[group['key']]).map { |row| row['menu_item_id'].to_i } %>
  <% items = assigned.select { |item| explicit_ids.include?(item.id) || (@selected_menu.product_matches?(item,group) && !rendered_ids.include?(item.id)) } %>
  <% rendered_ids |= items.map(&:id) %>
  <details class="panel menu-production-group" <%= 'open' if index.zero? %>><summary><strong><%= group['name'] %></strong><small><%= pluralize(items.size, 'produto', 'produtos') %> ⌄</small></summary><% items.each do |item| %><% offer = @selected_menu.individual_offers.find { |row| row['menu_item_id'].to_i == item.id } %><%= render 'staff/menu/item', item: item, status: @menu_status, item_price: (offer ? offer['price'] : item.price) %><% end %><% if items.empty? %><p class="menu-group-empty">Ainda sem produtos.</p><% end %></details>
<% end %>
<% remaining = assigned.reject { |item| rendered_ids.include?(item.id) } %>
<% if remaining.any? %><details class="panel menu-production-group" open><summary><strong>À unidade</strong><small><%= remaining.size %> ⌄</small></summary><% remaining.each do |item| %><% offer = @selected_menu.individual_offers.find { |row| row['menu_item_id'].to_i == item.id } %><%= render 'staff/menu/item', item: item, status: @menu_status, item_price: (offer ? offer['price'] : item.price) %><% end %></details><% end %>
</div>
<% pending = products.reject { |item| @scheduled_ids.include?(item.id) } %>
<% if pending.any? %><details class="panel menu-production-group menu-pending-products"><summary><strong>Produtos disponíveis para adicionar</strong><small><%= pending.size %> ⌄</small></summary><% pending.each do |item| %><%= render 'staff/menu/item', item: item, status: @menu_status, pending_menu: true %><% end %></details><% end %>
