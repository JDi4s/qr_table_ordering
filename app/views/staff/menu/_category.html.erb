<% status = local_assigns.fetch(:status, 'all') %>
<% children = category.children.order(:name).to_a %>
<% matching_children = children.select do |child|
  case status
  when 'active' then !child.archived? && child.available?
  when 'unavailable' then !child.archived? && !child.available?
  when 'archived' then child.archived?
  else true
  end
end %>
<% items = category.menu_items.order(:name).to_a.select do |item|
  case status
  when 'active' then !item.archived? && item.available?
  when 'unavailable' then !item.archived? && !item.available?
  when 'archived' then item.archived?
  else true
  end
end %>
<% matches = if status == 'active'
  !category.archived? && category.available?
elsif status == 'unavailable'
  !category.archived? && !category.available?
elsif status == 'archived'
  category.archived? || items.any? || matching_children.any?
else
  true
end %>
<% if matches %>
<section id="category-<%= category.id %>" class="panel category-panel category-level-<%= level %>">
  <div class="category-heading">
    <div class="category-title">
      <h2><%= category.name %></h2>
      <small class="category-status <%= category.archived? ? 'is-archived' : (category.available? ? 'is-available' : 'is-unavailable') %>"><%= category.archived? ? 'Arquivada' : (category.available? ? 'Disponível' : 'Indisponível') %></small>
    </div>
  <div class="category-actions">
    <% unless category.archived? %>
      <%= button_to (category.available? ? 'Desativar' : 'Ativar'),
        toggle_availability_staff_category_path(category),
        method: :patch,
        class: 'secondary compact-action',
        title: category.available? ? 'Tornar categoria indisponível' : 'Tornar categoria disponível' %>
    <% end %>

    <% if current_user.manager? %>
      <%= link_to 'Editar', edit_staff_category_path(category), class: 'compact-action' %>
      <% if category.archived? %>
        <%= button_to 'Restaurar', restore_staff_category_path(category), method: :patch, class: 'secondary compact-action' %>
      <% else %>
        <%= button_to 'Arquivar', staff_category_path(category), method: :delete, class: 'secondary compact-action' %>
      <% end %>
      <% unless category.uncategorized? %>
        <%= button_to 'Eliminar', purge_staff_category_path(category), method: :delete, class: 'destructive compact-action' %>
      <% end %>
    <% end %>
  </div>
  </div>

  <details class="staff-category-details">
    <summary>
      <%= items.count %> produtos
      <% if matching_children.any? %>
        · <%= matching_children.count %> <%= matching_children.count == 1 ? 'subcategoria' : 'subcategorias' %>
      <% else %>
        · ver categoria
      <% end %>
    </summary>
    <div class="staff-category-content">

  <% items.each do |item| %>
    <div class="line">
      <div>
        <strong><%= item.name %></strong>
        <% if item.description.present? %><p class="product-description"><%= item.description %></p><% end %>
        <p><%= euros(item.price) %> · <%= item.archived? ? 'Arquivado' : (item.available? ? 'Disponível' : 'Indisponível') %></p>
      </div>

      <div>
        <% unless item.archived? %>
          <%= button_to (item.available? ? 'Desativar' : 'Ativar'),
            toggle_availability_staff_menu_item_path(item),
            method: :patch,
            class: 'secondary compact-action',
            title: item.available? ? 'Tornar produto indisponível' : 'Tornar produto disponível' %>
        <% end %>

        <% if current_user.manager? %>
          <%= link_to 'Editar', edit_staff_menu_item_path(item), class: 'compact-action' %>
          <% if item.archived? %>
            <%= button_to 'Restaurar', restore_staff_menu_item_path(item), method: :patch, class: 'secondary compact-action' %>
          <% else %>
            <%= button_to 'Arquivar', staff_menu_item_path(item), method: :delete, class: 'secondary compact-action' %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

      <% matching_children.each do |child| %>
        <%= render 'staff/menu/category', category: child, level: level + 1, status: status %>
      <% end %>
    </div>
  </details>
</section>
<% end %>
