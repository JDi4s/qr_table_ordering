<h1>Organização do serviço</h1><%= render 'staff/settings/tabs' %>
<section class="panel"><h2>Balcão e cozinha</h2><%= form_with url: staff_service_organization_path, method: :patch do %><%= hidden_field_tag :operation, 'division' %><label class="form-check"><%= check_box_tag :enabled, '1', current_establishment.service_division_enabled? %> Dividir os pedidos por preparação</label><p>A sala aceita o pedido; cada posto prepara a sua parte.</p><%= submit_tag 'Guardar divisão' %><% end %></section>
<div class="service-config-grid">
<section class="panel"><h2>Postos de preparação</h2>
<% (@areas.to_a + [ProductionArea.new(active: true)]).each do |area| %><details class="service-config-record"><summary><%= area.name.presence || '+ Criar posto' %></summary><%= form_with url: staff_service_organization_path, method: :patch do %><%= hidden_field_tag :operation, 'area' %><%= hidden_field_tag :area_id, area.id %><%= label_tag "area_name_#{area.id}", 'Nome' %><%= text_field_tag 'area[name]', area.name, id: "area_name_#{area.id}", required: true %><%= label_tag "area_key_#{area.id}", 'Prepara' %><%= select_tag 'area[preparation_key]', options_for_select(MenuItem::PREPARATION_KEYS.map { |key,label| [label,key] }, area.preparation_key), id: "area_key_#{area.id}" %><%= hidden_field_tag 'area[active]', '0' %><label class="form-check"><%= check_box_tag 'area[active]', '1', area.active? %> Posto ativo</label><%= submit_tag 'Guardar posto' %><% end %></details><% end %>
</section>
<section class="panel"><h2>Zonas das mesas</h2>
<% (@zones.to_a + [ServiceZone.new]).each do |zone| %><details class="service-config-record"><summary><%= zone.name.presence || '+ Criar zona' %></summary><%= form_with url: staff_service_organization_path, method: :patch do %><%= hidden_field_tag :operation, 'zone' %><%= hidden_field_tag :zone_id, zone.id %><%= label_tag "zone_name_#{zone.id}", 'Nome da zona' %><%= text_field_tag 'zone[name]', zone.name, id: "zone_name_#{zone.id}", required: true %><% MenuItem::PREPARATION_KEYS.each do |key,label| %><%= label_tag "zone_#{zone.id}_#{key}", "#{label} → posto" %><%= select_tag "zone[routing][#{key}]", options_from_collection_for_select(@areas.where(active: true), :id, :name, zone.routing[key]), prompt: 'Usar posto geral', id: "zone_#{zone.id}_#{key}" %><% end %><%= submit_tag 'Guardar zona' %><% end %></details><% end %>
</section>
</div>
<section class="panel"><h2>Atribuir mesas em lote</h2><%= form_with url: staff_service_organization_path, method: :patch, class: 'service-bulk-fields' do %><%= hidden_field_tag :operation, 'tables' %><label>Da mesa <%= number_field_tag :first, nil, min: 1, required: true %></label><label>Até à mesa <%= number_field_tag :last, nil, min: 1, required: true %></label><label>Zona <%= select_tag :zone_id, options_from_collection_for_select(@zones, :id, :name), prompt: 'Escolher zona', required: true %></label><%= submit_tag 'Atribuir mesas' %><% end %></section>
