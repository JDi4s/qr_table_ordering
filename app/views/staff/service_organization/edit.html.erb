<h1>Organização do serviço</h1><%= render 'staff/settings/tabs' %>
<section class="panel service-division-heading"><div><h2>Áreas de preparação</h2><p>Cada área recebe os produtos que lhe forem atribuídos.</p><p class="service-permission-state"><%= current_establishment.production_areas.where(active: true).count %> áreas ativas / <%= current_establishment.production_areas_limit %> permitidas</p></div>
<% if current_establishment.production_areas_enabled? %><%= form_with url: staff_service_organization_path, method: :patch do %><%= hidden_field_tag :operation, 'division' %><label class="form-check"><%= check_box_tag :enabled, '1', current_establishment.service_division_enabled? %> Separar a preparação por áreas</label><%= submit_tag 'Guardar divisão' %><% end %><% else %><p class="flash alert">A divisão por áreas não está autorizada. A Administração pode ativar esta permissão e definir o número de áreas.</p><% end %></section>
<% if current_establishment.production_areas_enabled? %>
<div class="service-config-grid">
<section class="panel"><h2>As tuas áreas</h2><p>Escolhe os nomes: Balcão, Cozinha principal, Bar do piso 1…</p>
<% editable_areas = @areas.to_a %><% editable_areas << ProductionArea.new(active: true) if @areas.where(active: true).count < current_establishment.production_areas_limit %>
<% editable_areas.each do |area| %><details class="service-config-record"><summary><%= area.name.presence || '+ Criar área' %><%= ' · desativada' if area.persisted? && !area.active? %></summary><%= form_with url: staff_service_organization_path, method: :patch do %><%= hidden_field_tag :operation, 'area' %><%= hidden_field_tag :area_id, area.id %><%= label_tag "area_name_#{area.id}", 'Nome da área' %><%= text_field_tag 'area[name]', area.name, id: "area_name_#{area.id}", required: true, placeholder: 'Ex.: Cozinha principal' %><%= label_tag "area_key_#{area.id}", 'Função da área' %><%= select_tag 'area[preparation_key]', options_for_select(MenuItem::PREPARATION_KEYS.map { |key,label| [label,key] }, area.preparation_key), id: "area_key_#{area.id}" %><small>A função permite encaminhar produtos para outra área equivalente consoante a zona da mesa.</small><%= hidden_field_tag 'area[active]', '0' %><label class="form-check"><%= check_box_tag 'area[active]', '1', area.active? %> Área ativa</label><%= submit_tag 'Guardar área' %><% end %></details><% end %>
<% if @areas.where(active: true).count >= current_establishment.production_areas_limit %><p class="service-limit-note">Todas as áreas autorizadas estão em uso. A Administração pode aumentar o limite.</p><% end %>
</section>
<section class="panel"><h2>Zonas das mesas</h2><p>Usa zonas quando tens vários pisos ou balcões. Sem uma zona, o pedido segue para a área escolhida no produto.</p>
<% (@zones.to_a + [ServiceZone.new]).each do |zone| %><details class="service-config-record"><summary><%= zone.name.presence || '+ Criar zona' %></summary><%= form_with url: staff_service_organization_path, method: :patch do %><%= hidden_field_tag :operation, 'zone' %><%= hidden_field_tag :zone_id, zone.id %><%= label_tag "zone_name_#{zone.id}", 'Nome da zona' %><%= text_field_tag 'zone[name]', zone.name, id: "zone_name_#{zone.id}", required: true, placeholder: 'Ex.: Piso 1' %><% MenuItem::PREPARATION_KEYS.each do |key,label| %><%= label_tag "zone_#{zone.id}_#{key}", "#{label} → área de destino" %><%= select_tag "zone[routing][#{key}]", options_from_collection_for_select(current_establishment.available_production_areas, :id, :name, zone.routing[key]), prompt: 'Usar a área do produto', id: "zone_#{zone.id}_#{key}" %><% end %><%= submit_tag 'Guardar zona' %><% end %></details><% end %>
</section>
</div>
<section class="panel"><h2>Associar mesas a uma zona</h2><%= form_with url: staff_service_organization_path, method: :patch, class: 'service-bulk-fields' do %><%= hidden_field_tag :operation, 'tables' %><label>Da mesa <%= number_field_tag :first, nil, min: 1, required: true %></label><label>Até à mesa <%= number_field_tag :last, nil, min: 1, required: true %></label><label>Zona <%= select_tag :zone_id, options_from_collection_for_select(@zones, :id, :name), prompt: 'Escolher zona', required: true %></label><%= submit_tag 'Associar mesas' %><% end %></section>
<% end %>
