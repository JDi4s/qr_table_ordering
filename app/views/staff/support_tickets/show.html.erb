<%= turbo_stream_from 'support', channel: 'SupportTicketsChannel', data: { scope: 'ticket', ticket_id: @ticket.id } %>
<p class="eyebrow">CONFIGURAÇÃO DO SERVIÇO</p><h1>Definições</h1><%= render 'staff/settings/tabs' %>
<%= link_to '‹ Voltar ao apoio', staff_support_tickets_path, class: 'admin-back-link' %>
<section class="panel ticket-conversation staff-ticket-conversation">
  <div class="ticket-title"><div><p class="eyebrow">TICKET #<%= @ticket.id %> · <%= support_ticket_category_label(@ticket.category) %></p><h2><%= @ticket.subject %></h2></div><%= render 'support_tickets/status', ticket: @ticket %></div>
  <div id="support_ticket_messages_<%= @ticket.id %>" class="ticket-messages"><%= render partial: 'support_tickets/message', collection: @ticket.messages, as: :message %></div>
  <%= render 'staff/support_tickets/reply', ticket: @ticket %>
</section>
