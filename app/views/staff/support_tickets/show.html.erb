<p class="eyebrow">CONFIGURAÇÃO DO SERVIÇO</p><h1>Definições</h1><%= render 'staff/settings/tabs' %><%= link_to '‹ Voltar ao apoio', staff_support_tickets_path, class: 'admin-back-link' %>
<section class="panel ticket-conversation staff-ticket-conversation"><div class="ticket-title"><div><p class="eyebrow">TICKET #<%= @ticket.id %> · <%= support_ticket_category_label(@ticket.category) %></p><h2><%= @ticket.subject %></h2></div><span class="ticket-status status-<%= @ticket.status %>"><%= support_ticket_status_label(@ticket.status) %></span></div><div class="ticket-messages"><% @ticket.messages.each do |message| %><article class="ticket-message <%= message.from_support? ? 'from-support' : 'from-establishment' %>"><div><strong><%= message.from_support? ? 'Suporte' : message.author.display_identity %></strong><time><%= message.created_at.strftime('%d/%m/%Y %H:%M') %></time></div><%= simple_format(message.body) if message.body.present? %><%= link_to image_tag(message.attachment, alt: 'Imagem anexada'), rails_blob_path(message.attachment, disposition: 'attachment'), class: 'ticket-attachment', data: { turbo: false } if message.attachment.attached? %></article><% end %></div><% unless @ticket.resolved? %><%= form_with model: [@ticket, @message], url: staff_support_ticket_messages_path(@ticket), class: 'ticket-reply-form', html: { multipart: true } do |f| %><%= f.label :body, 'Responder' %><%= f.text_area :body, rows: 4, maxlength: 5000 %><%= f.file_field :attachment, accept: 'image/png,image/jpeg,image/webp' %><%= f.submit 'Enviar mensagem' %><% end %><% else %><div class="support-resolved-note"><strong>Este pedido está resolvido.</strong><span>Se surgir outro problema, abre um novo ticket.</span></div><% end %></section>
