<p class="eyebrow">CONFIGURAÇÃO DO SERVIÇO</p><h1>Definições</h1><%= render 'staff/settings/tabs' %><%= link_to '‹ Voltar ao apoio', staff_support_tickets_path, class: 'admin-back-link' %>
<section class="panel support-ticket-form"><p class="eyebrow">NOVO PEDIDO</p><h2>Como podemos ajudar?</h2><p>Explica o que aconteceu de forma simples. Se possível, junta uma imagem do ecrã.</p><%= render 'shared/errors', record: @ticket %><%= form_with model: @ticket, url: staff_support_tickets_path, html: { multipart: true } do |f| %><div class="support-form-grid"><div><%= f.label :category, 'Área' %><%= f.select :category, SupportTicket::CATEGORIES.map { |value| [support_ticket_category_label(value), value] } %></div><div><%= f.label :priority, 'Prioridade' %><%= f.select :priority, [['Normal','normal'],['Urgente — serviço bloqueado','urgent']] %></div></div><%= f.label :subject, 'Assunto' %><%= f.text_field :subject, required: true, maxlength: 140, placeholder: 'Ex.: Não consigo alterar um produto' %><%= label_tag 'support_ticket_message', 'O que está a acontecer?' %><%= text_area_tag 'support_ticket[message]', params.dig(:support_ticket, :message), id: 'support_ticket_message', required: true, rows: 6, maxlength: 5000, placeholder: 'Diz-nos o que tentaste fazer e o que apareceu…' %><%= label_tag 'support_ticket_attachment', 'Imagem (opcional)' %><%= file_field_tag 'support_ticket[attachment]', id: 'support_ticket_attachment', accept: 'image/png,image/jpeg,image/webp' %><small>PNG, JPG ou WebP até 5 MB. Nunca envies palavras-passe.</small><%= f.submit 'Enviar pedido de apoio' %><% end %></section>
