<article class="panel staff-order-card" id="<%= dom_id(order) %>" data-staff-board-target="order" data-board-status="<%= order.status %>">
  <div class="staff-order-card-heading">
    <div><h2>Mesa <%= order.table.display_number %> <span>· Pedido #<%= order.id %></span></h2><p class="staff-order-meta"><%= order.created_at.strftime('%H:%M') %> · <%= pluralize(order.order_items.sum(&:quantity), 'artigo') %></p></div>
    <span class="badge order-status order-status-<%= order.status %>"><%= state_label(order.status) %></span>
  </div>
  <div class="staff-order-content"><ul class="staff-order-items"><% order.order_items.each do |item| %><li><%= item.quantity %> × <%= item.display_name %> <%= "· #{item.menu_item.production_area.name}" if item.menu_item.production_area.present? %> <%= '(rejeitado)' if item.denied? %></li><% end %></ul><strong><%= euros(order.outstanding_total) %></strong></div>
  <% if order.note.present? %><p class="staff-order-note">Observação: <%= truncate(order.note, length: 90) %></p><% end %>
  <div class="staff-card-actions">
    <%= link_to(order.pending? ? 'Avaliar pedido' : 'Abrir pedido', staff_order_path(order), class: 'button secondary') %>
    <% if order.pending? %><%= button_to 'Aceitar', staff_order_path(order, status: 'accepted'), method: :patch, aria: { label: 'Aceitar pedido sem alterações' } %><% end %>
    <% if order.accepted? %><%= button_to 'Marcar servido', staff_order_path(order, status: 'served'), method: :patch %><% end %>
  </div>
</article>
