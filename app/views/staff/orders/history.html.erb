<div class="history-page">
  <div class="history-heading">
    <div>
      <h1>Histórico</h1>
      <p>Consulta todos os pedidos terminados e filtra por período ou estado.</p>
    </div>
  </div>

  <div class="history-summary-grid">
    <div class="history-summary-card">
      <strong><%= @history_total %></strong>
      <span>Pedidos encontrados</span>
    </div>
    <div class="history-summary-card">
      <strong><%= euros(@history_received) %></strong>
      <span>Total recebido</span>
    </div>
    <div class="history-summary-card">
      <strong><%= @history_tables %></strong>
      <span>Mesas utilizadas</span>
    </div>
  </div>

  <section class="panel history-filters">
    <h2>Escolher período</h2>
    <div class="history-quick-filters">
      <%= link_to 'Todos', history_staff_orders_path(status: (@history_status == 'all' ? nil : @history_status)), class: (@history_period == 'all' ? 'is-active' : '') %>
      <%= link_to 'Hoje', history_staff_orders_path(period: 'today', status: (@history_status == 'all' ? nil : @history_status)), class: (@history_period == 'today' ? 'is-active' : '') %>
      <%= link_to 'Ontem', history_staff_orders_path(period: 'yesterday', status: (@history_status == 'all' ? nil : @history_status)), class: (@history_period == 'yesterday' ? 'is-active' : '') %>
      <%= link_to 'Últimos 7 dias', history_staff_orders_path(period: 'last_7_days', status: (@history_status == 'all' ? nil : @history_status)), class: (@history_period == 'last_7_days' ? 'is-active' : '') %>
      <%= link_to 'Personalizado', history_staff_orders_path(period: 'custom', from: @history_from_value, to: @history_to_value, status: (@history_status == 'all' ? nil : @history_status)), class: (@history_period == 'custom' ? 'is-active' : '') %>
    </div>

    <%= form_with url: history_staff_orders_path, method: :get, class: 'history-filter-form' do %>
      <%= hidden_field_tag :period, 'custom' %>
      <div>
        <%= label_tag :from, 'De' %>
        <%= datetime_local_field_tag :from, @history_from_value %>
      </div>
      <div>
        <%= label_tag :to, 'Até' %>
        <%= datetime_local_field_tag :to, @history_to_value %>
      </div>
      <div>
        <%= label_tag :status, 'Estado' %>
        <%= select_tag :status, options_for_select([['Todos', 'all'], ['Servidos', 'served'], ['Cancelados', 'denied']], @history_status) %>
      </div>
      <%= submit_tag 'Aplicar intervalo', class: 'secondary' %>
      <%= link_to 'Limpar', history_staff_orders_path, class: 'button secondary history-clear-filter' %>
    <% end %>
  </section>

  <% if @orders.any? %>
    <div class="history-list">
      <% @orders.each do |order| %>
        <%= render 'history_order', order: order %>
      <% end %>
    </div>
  <% else %>
    <section class="panel empty-state">
      <strong>Não existem pedidos neste filtro.</strong>
      <p>Tenta escolher outro período ou estado.</p>
    </section>
  <% end %>
</div>
