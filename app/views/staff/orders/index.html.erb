<p class="eyebrow">SERVIÇO EM TEMPO REAL</p><h1>Pedidos e chamadas</h1>
<p>Mantenha esta página aberta durante o serviço.</p>
<div class="toolbar">
  <button type="button" class="secondary" data-action="staff-orders#enableAudio">Ativar / testar som</button>
  <button type="button" class="secondary" data-action="staff-orders#enableNotifications">Ativar notificações no dispositivo</button>
</div>
<p class="push-status" data-staff-orders-target="pushStatus"></p>
<p><%= link_to 'Ver Mesas ativas e pedidos por pagar', active_staff_tables_path, class: 'button' %></p>
<%= turbo_stream_from 'staff', channel: 'OrdersChannel' %>
<h2>Chamadas à mesa</h2><div id="service_calls" class="grid empty-list">
  <% @service_calls.each do |service_call| %><%= render 'staff/service_calls/call', service_call: service_call %><% end %>
</div>
<h2>Pedidos em curso</h2><div id="staff_orders_live" class="grid empty-list">
  <% @orders.each do |order| %><%= render 'order_row', order: order %><% end %>
</div>
