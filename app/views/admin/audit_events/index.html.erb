<div class="admin-page-heading"><div><p class="eyebrow">RASTREABILIDADE INTERNA</p><h1>Logs da plataforma</h1><p>Quem fez o quê, onde e quando. Os estabelecimentos veem apenas a identidade “Suporte”.</p></div></div>
<%= form_with url: admin_audit_events_path, method: :get, class: 'admin-log-filter' do %><%= select_tag :establishment_id, options_for_select([['Todos os estabelecimentos','']] + @establishments.map { |item| [item.name, item.id] }, @establishment&.id), onchange: 'this.form.requestSubmit()', aria: { label: 'Filtrar estabelecimento' } %><% end %>
<section class="panel admin-log-list"><% if @events.any? %><% @events.each do |event| %><div class="admin-log-row"><div><strong><%= audit_actor_label(event, internal: true) %></strong><span><%= audit_action_label(event.action) %><% if event.auditable_id %> · #<%= event.auditable_id %><% end %></span><small><%= event.establishment.name %></small></div><time><%= event.created_at.strftime('%d/%m/%Y %H:%M') %></time></div><% end %><% else %><p>Ainda não existem ações registadas.</p><% end %></section>
