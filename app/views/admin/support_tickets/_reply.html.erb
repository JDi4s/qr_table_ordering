<div id="support_ticket_reply_<%= ticket.id %>">
  <% unless ticket.resolved? %>
    <%= form_with model: SupportTicketMessage.new, url: admin_support_ticket_messages_path(ticket), class: 'ticket-reply-form', html: { multipart: true } do |f| %>
      <%= f.label :body, 'Responder como Suporte' %><%= f.text_area :body, rows: 4, maxlength: 5000, placeholder: 'Escreve uma resposta simples e objetiva…' %>
      <%= f.file_field :attachment, accept: 'image/png,image/jpeg,image/webp' %><%= f.submit 'Enviar resposta' %>
    <% end %>
  <% end %>
</div>
