<%= turbo_stream_from 'support', channel: 'SupportTicketsChannel', data: { scope: 'ticket', ticket_id: @ticket.id } %>
<%= link_to '‹ Voltar aos tickets', admin_support_tickets_path, class: 'admin-back-link' %>
<div class="admin-ticket-layout">
  <section class="panel ticket-conversation">
    <div class="ticket-title"><div><p class="eyebrow"><%= @ticket.establishment.name %> · TICKET #<%= @ticket.id %></p><h1><%= @ticket.subject %></h1></div><%= render 'support_tickets/status', ticket: @ticket %></div>
    <div id="support_ticket_messages_<%= @ticket.id %>" class="ticket-messages"><%= render partial: 'support_tickets/message', collection: @ticket.messages, as: :message %></div>
    <%= render 'admin/support_tickets/reply', ticket: @ticket %>
  </section>
  <aside class="panel ticket-sidebar">
    <h2>Gerir ticket</h2>
    <%= form_with model: [:admin, @ticket] do |f| %><%= f.label :status, 'Estado' %><%= f.select :status, SupportTicket::STATUSES.map { |value| [support_ticket_status_label(value), value] } %><%= f.label :priority, 'Prioridade' %><%= f.select :priority, [['Normal','normal'],['Urgente','urgent']] %><%= f.submit 'Guardar estado' %><% end %>
    <hr><p><strong>Categoria</strong><br><%= support_ticket_category_label(@ticket.category) %></p><p><strong>Aberto por</strong><br><%= @ticket.created_by.display_identity %></p>
    <%= form_with url: admin_support_sessions_path do %><%= hidden_field_tag :establishment_id, @ticket.establishment_id %><%= hidden_field_tag :support_ticket_id, @ticket.id %><%= submit_tag 'Entrar como Suporte', class: 'secondary' %><small>Acesso de 30 minutos associado a este ticket.</small><% end %>
  </aside>
</div>
