<%= link_to '‹ Voltar aos tickets', admin_support_tickets_path, class: 'admin-back-link' %>
<div class="admin-ticket-layout"><section class="panel ticket-conversation"><div class="ticket-title"><div><p class="eyebrow"><%= @ticket.establishment.name %> · TICKET #<%= @ticket.id %></p><h1><%= @ticket.subject %></h1></div><span class="ticket-status status-<%= @ticket.status %>"><%= support_ticket_status_label(@ticket.status) %></span></div><div class="ticket-messages"><% @ticket.messages.each do |message| %><article class="ticket-message <%= message.from_support? ? 'from-support' : 'from-establishment' %>"><div><strong><%= message.from_support? ? 'Suporte' : message.author.display_identity %></strong><time><%= message.created_at.strftime('%d/%m/%Y %H:%M') %></time></div><%= simple_format(message.body) if message.body.present? %><%= link_to image_tag(message.attachment, alt: 'Imagem anexada'), rails_blob_path(message.attachment, disposition: 'attachment'), class: 'ticket-attachment', data: { turbo: false } if message.attachment.attached? %></article><% end %></div><% unless @ticket.resolved? %><%= form_with model: [:admin, @ticket, @message], url: admin_support_ticket_messages_path(@ticket), class: 'ticket-reply-form' do |f| %><%= f.label :body, 'Responder como Suporte' %><%= f.text_area :body, rows: 4, maxlength: 5000, placeholder: 'Escreve uma resposta simples e objetiva…' %><%= f.file_field :attachment, accept: 'image/png,image/jpeg,image/webp' %><%= f.submit 'Enviar resposta' %><% end %><% end %></section><aside class="panel ticket-sidebar"><h2>Gerir ticket</h2><%= form_with model: [:admin, @ticket] do |f| %><%= f.label :status, 'Estado' %><%= f.select :status, SupportTicket::STATUSES.map { |value| [support_ticket_status_label(value), value] } %><%= f.label :priority, 'Prioridade' %><%= f.select :priority, [['Normal','normal'],['Urgente','urgent']] %><%= f.submit 'Guardar estado' %><% end %><hr><p><strong>Categoria</strong><br><%= support_ticket_category_label(@ticket.category) %></p><p><strong>Aberto por</strong><br><%= @ticket.created_by.display_identity %></p><%= form_with url: admin_support_sessions_path do %><%= hidden_field_tag :establishment_id, @ticket.establishment_id %><%= hidden_field_tag :support_ticket_id, @ticket.id %><%= submit_tag 'Entrar como Suporte', class: 'secondary' %><small>Acesso de 30 minutos associado a este ticket.</small><% end %></aside></div>
