<div class="admin-page-heading"><div><p class="eyebrow">APOIO AOS ESTABELECIMENTOS</p><h1>Tickets</h1><p>Pedidos que precisam de resposta ou acompanhamento.</p></div></div>
<nav class="admin-filter-tabs"><% [['unresolved','Por resolver'],['open','Abertos'],['in_analysis','Em análise'],['waiting_establishment','A aguardar'],['resolved','Resolvidos']].each do |value, label| %><%= link_to label, admin_support_tickets_path(status: value), class: (@status == value ? 'is-active' : '') %><% end %></nav>
<section class="admin-ticket-list"><% if @tickets.any? %><% @tickets.each do |ticket| %><%= link_to admin_support_ticket_path(ticket), class: 'admin-ticket-row' do %><div><span class="ticket-priority <%= 'is-urgent' if ticket.priority == 'urgent' %>"><%= ticket.priority == 'urgent' ? 'Urgente' : support_ticket_category_label(ticket.category) %></span><strong><%= ticket.subject %></strong><small><%= ticket.establishment.name %> · #<%= ticket.id %> · atualizado <%= time_ago_in_words(ticket.updated_at) %></small></div><span class="ticket-status status-<%= ticket.status %>"><%= support_ticket_status_label(ticket.status) %></span><% end %><% end %><% else %><div class="admin-empty-state"><strong>Nenhum ticket nesta lista</strong><p>Quando chegar um pedido, aparece aqui.</p></div><% end %></section>
