<%= render 'shared/errors', record: @establishment %>
<%= form_with model: [:admin, @establishment] do |f| %>
  <%= f.label :name, 'Nome do estabelecimento' %><%= f.text_field :name, required: true %>
  <%= f.label :slug, 'Identificador (por exemplo: cafe-central)' %><%= f.text_field :slug, required: true, pattern: '[a-z0-9]+(-[a-z0-9]+)*' %>
  <%= f.label :table_limit, 'Limite de mesas ativas' %><%= f.number_field :table_limit, min: 0, required: true %>
  <%= f.label :monthly_fee, 'Mensalidade acordada (€)' %><%= f.number_field :monthly_fee, min: 0, step: '0.01', required: true %>
  <%= f.label :plan, 'Plano comercial' %><%= f.select :plan, [['Essencial — hoje e últimos 7 dias', 'essential'], ['Gestão — estatísticas completas', 'management']], {}, required: true %>
  <section class="admin-area-permissions" data-controller="area-permission">
    <h2>Áreas de preparação</h2>
    <label class="form-check"><%= check_box_tag :allow_service_areas, '1', @establishment.production_areas_enabled?, data: { area_permission_target: 'toggle', action: 'change->area-permission#sync' } %> Permitir divisão por áreas</label>
    <%= f.label :production_areas_limit, 'Número máximo de áreas' %><%= f.number_field :production_areas_limit, min: 0, required: true, data: { area_permission_target: 'limit' } %>
    <small>O gerente escolhe os nomes e os colaboradores de cada área. Zero desliga esta permissão; 1, 2, 3, 4 ou mais definem o limite.</small>
  </section>
  <label><%= f.check_box :active %> Estabelecimento ativo</label>
  <label><%= f.check_box :google_reviews_enabled %> Ativar avaliações Google para este estabelecimento</label>
  <small>Permite ao gerente configurar a ligação. O convite aparece ao cliente após enviar um pedido.</small>
  <% if @establishment.new_record? %>
    <h2>Acesso inicial do gerente</h2>
    <label for="manager_name">Nome</label><%= text_field_tag 'manager[name]', nil, id: 'manager_name', required: true %>
    <label for="manager_email">Email</label><%= email_field_tag 'manager[email]', nil, id: 'manager_email', required: true %>
    <label for="manager_password">Palavra-passe (mínimo 12 caracteres)</label><%= password_field_tag 'manager[password]', nil, id: 'manager_password', required: true, minlength: 12, autocomplete: 'new-password' %>
  <% end %>
  <%= f.submit 'Guardar' %>
<% end %>
