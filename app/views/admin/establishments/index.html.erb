<div class="admin-page-heading"><div><p class="eyebrow">ADMINISTRAÇÃO DA PLATAFORMA</p><h1>Visão geral</h1><p>Acompanha clientes, pedidos de apoio e intervenções num único lugar.</p></div><%= link_to 'Criar estabelecimento', new_admin_establishment_path, class: 'button' %></div>
<section class="admin-summary-grid" aria-label="Resumo da plataforma"><article><span>Clientes ativos</span><strong><%= @active_clients_count %></strong></article><article><span>Tickets por resolver</span><strong><%= @open_tickets_count %></strong></article><article><span>Mensalidade acordada</span><strong><%= euros(@monthly_revenue_cents / 100.0) %></strong></article></section>
<% if @active_support_sessions.any? %><section class="admin-live-support"><strong>Intervenções ativas</strong><% @active_support_sessions.each do |support_session| %><span><%= support_session.platform_admin.name.presence || support_session.platform_admin.email %> em <%= support_session.establishment.name %> até <%= support_session.expires_at.strftime('%H:%M') %></span><% end %></section><% end %>
<div class="admin-section-heading"><div><p class="eyebrow">CLIENTES</p><h2>Estabelecimentos</h2></div><span><%= @establishments.size %> registados</span></div>
<div class="admin-client-grid"><% @establishments.each do |establishment| %><article class="admin-client-card <%= 'is-suspended' unless establishment.active? %>"><div class="admin-client-card-head"><div><h2><%= establishment.name %></h2><span class="status-dot"><%= establishment.active? ? 'Ativo' : 'Suspenso' %></span></div><span class="plan-badge"><%= plan_label(establishment) %></span></div><div class="admin-client-metrics"><div><strong><%= establishment.tables.count(&:active?) %>/<%= establishment.table_limit %></strong><span>mesas</span></div><div><strong><%= establishment.support_tickets.count { |ticket| !ticket.resolved? } %></strong><span>tickets</span></div><div><strong><%= euros(establishment.monthly_fee) %></strong><span>mensalidade</span></div></div><div class="admin-client-actions"><%= link_to 'Contrato e plano', edit_admin_establishment_path(establishment), class: 'button secondary' %><%= link_to 'Ver tickets', admin_support_tickets_path(establishment_id: establishment.id), class: 'button secondary' %></div><details class="admin-support-entry"><summary>Entrar como Suporte</summary><%= form_with url: admin_support_sessions_path do %><%= hidden_field_tag :establishment_id, establishment.id %><%= label_tag "reason_#{establishment.id}", 'Motivo da intervenção' %><%= text_field_tag :reason, nil, id: "reason_#{establishment.id}", required: true, maxlength: 240, placeholder: 'Ex.: corrigir menu solicitado por telefone' %><div><small>A sessão dura 30 minutos e todas as alterações ficam registadas.</small><%= submit_tag 'Iniciar intervenção' %></div><% end %></details></article><% end %></div>
