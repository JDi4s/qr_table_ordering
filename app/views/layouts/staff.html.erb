<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta name="turbo-cache-control" content="no-cache">
  <title>Bocato — Gestão</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#192d24">
  <%= render 'layouts/brand_icons' %>
  <%= csrf_meta_tags %><%= csp_meta_tag %><%= action_cable_meta_tag %>
  <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
  <%= stylesheet_link_tag 'google_reviews', 'data-turbo-track': 'reload' %>
  <%= stylesheet_link_tag 'report_extract', 'data-turbo-track': 'reload' %>
  <%= stylesheet_link_tag 'table_activation', 'data-turbo-track': 'reload' %>
  <%= javascript_importmap_tags %>
</head>
<body data-controller="staff-orders table-activation"
      data-table-activation-url-value="<%= staff_table_visits_path %>"
      data-table-activation-orders-url-value="<%= staff_orders_path %>"
      data-table-activation-key-value="<%= current_establishment.id %>-<%= current_user.id %>"
      data-staff-sound-enabled="<%= current_user&.staff_sound_enabled? ? '1' : '0' %>"
      data-vapid-public-key="<%= h(ENV['VAPID_PUBLIC_KEY'].to_s) %>"
      data-web-push-enabled="<%= ENV['VAPID_PUBLIC_KEY'].present? ? '1' : '0' %>">
  <%= render 'staff/shared/nav' %>
  <% if current_user.manager? && !support_mode? %>
    <%= turbo_stream_from 'support', channel: 'SupportTicketsChannel', data: { scope: 'notifications' } %>
  <% end %>
  <main>
    <%= render 'layouts/flash_notifications' %>
    <div id="staff_notifications" aria-live="assertive"></div>
    <div id="support_notifications" aria-live="polite"></div>
    <%= yield %>
  </main>
</body>
</html>
