<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <title>Mesa — Administração</title><meta name="viewport" content="width=device-width, initial-scale=1"><link rel="manifest" href="/manifest.json"><meta name="theme-color" content="#0d513d">
  <%= csrf_meta_tags %><%= csp_meta_tag %><%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %><%= javascript_importmap_tags %>
</head>
<body class="admin-body" data-vapid-public-key="<%= h(ENV['VAPID_PUBLIC_KEY'].to_s) %>">
  <header class="admin-header">
    <div class="admin-brand"><span class="brand">Mesa<span> • </span></span><small>Administração</small></div>
    <nav class="admin-main-nav" aria-label="Administração da plataforma">
      <%= link_to 'Clientes', admin_establishments_path, class: ('is-active' if controller_path == 'admin/establishments') %>
      <%= link_to admin_support_tickets_path, class: ('is-active' if controller_path.include?('support_ticket')) do %>Tickets<% if SupportTicket.unresolved.exists? %><span><%= SupportTicket.unresolved.count %></span><% end %><% end %>
      <%= link_to 'Logs', admin_audit_events_path, class: ('is-active' if controller_path == 'admin/audit_events') %>
    </nav>
    <div class="admin-header-actions"><button type="button" class="secondary admin-push-button" data-admin-push>Ativar alertas</button><%= button_to 'Sair', logout_path, method: :delete, class: 'secondary' %></div>
  </header>
  <main class="admin-main"><% flash.each do |kind, message| %><div class="flash <%= kind %>" role="status"><%= message %></div><% end %><%= yield %></main>
  <script>
    (() => {
      const button = document.querySelector('[data-admin-push]'); const publicKey = document.body.dataset.vapidPublicKey;
      if (!button || !publicKey || !('serviceWorker' in navigator) || !('PushManager' in window)) { if (button) button.hidden = true; return; }
      const decode = value => { const padding = '='.repeat((4 - value.length % 4) % 4); const raw = atob((value + padding).replace(/-/g, '+').replace(/_/g, '/')); return Uint8Array.from([...raw].map(char => char.charCodeAt(0))); };
      button.addEventListener('click', async () => { try { const registration = await navigator.serviceWorker.register('/staff-service-worker.js'); const permission = await Notification.requestPermission(); if (permission !== 'granted') throw new Error(); let subscription = await registration.pushManager.getSubscription(); subscription ||= await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: decode(publicKey) }); const token = document.querySelector('meta[name="csrf-token"]').content; const response = await fetch('<%= admin_push_subscription_path %>', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': token }, body: JSON.stringify({ subscription: subscription.toJSON() }) }); if (!response.ok) throw new Error(); button.textContent = 'Alertas ativos'; button.disabled = true; } catch (_error) { button.textContent = 'Tentar ativar alertas'; } });
    })();
  </script>
</body></html>
