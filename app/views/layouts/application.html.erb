<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <title>Bocato — Pedidos por QR</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#192d24">
  <%= render 'layouts/brand_icons' %>
  <%= csrf_meta_tags %><%= csp_meta_tag %><%= action_cable_meta_tag %>
  <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
  <%= stylesheet_link_tag 'google_reviews', 'data-turbo-track': 'reload' %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <header><div class="platform-brand-lockup"><%= image_tag 'bocato-logo.png', alt: 'Bocato', class: 'platform-logo' %><span>Pedidos, à sua mesa.</span></div>
    <% if current_user %><%= button_to 'Sair', logout_path, method: :delete, class: 'secondary' %><% end %>
  </header>
  <main>
    <% flash.each do |kind, message| %><div class="flash <%= kind %>" role="status"><%= message %></div><% end %>
    <%= yield %>
  </main>
</body>
</html>
