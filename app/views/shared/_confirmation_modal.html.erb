<div class="app-confirmation" data-controller="confirmation" data-confirmation-modal hidden>
  <div class="app-confirmation-backdrop" data-action="click->confirmation#cancel"></div>
  <section class="app-confirmation-dialog" role="dialog" aria-modal="true" aria-labelledby="app-confirmation-title">
    <h2 id="app-confirmation-title">Confirmar ação</h2>
    <p data-confirmation-target="message"></p>
    <div class="app-confirmation-actions">
      <button type="button" class="secondary" data-confirmation-target="cancel" data-action="confirmation#cancel">Cancelar</button>
      <button type="button" data-confirmation-target="confirm" data-action="confirmation#confirm">Confirmar</button>
    </div>
  </section>
</div>
