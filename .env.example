APP_PUBLIC_URL=https://mesas.example.com
SECRET_KEY_BASE=replace_with_128_random_hex_characters
POSTGRES_PASSWORD=replace_with_64_random_hex_characters
RAILS_LOG_LEVEL=info
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional abuse protection overrides. Defaults are deliberately generous for
# venues where customers and staff share the same public IP address.
RATE_LIMIT_LOGIN_ACCOUNT_10M=10
RATE_LIMIT_LOGIN_IP_10M=100
RATE_LIMIT_ORDERS_CUSTOMER_10M=15
RATE_LIMIT_ORDERS_CUSTOMER_1H=60
RATE_LIMIT_ORDERS_TABLE_10M=40
RATE_LIMIT_ORDERS_TABLE_1H=120
RATE_LIMIT_ORDERS_IP_10M=600
RATE_LIMIT_CALLS_CUSTOMER_10M=5
RATE_LIMIT_CALLS_TABLE_10M=10
RATE_LIMIT_CALLS_IP_10M=300
